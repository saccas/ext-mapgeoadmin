{
    "name": "saccas/mapgeoadmin",
    "description": "map geo admin extension https://map.geo.admin.ch",
    "type": "typo3-cms-extension",
    "homepage": "https://map.geo.admin.ch",
    "license": ["GPL-2.0-or-later"],
    "autoload": {
        "psr-4": {
            "Saccas\\Mapgeoadmin\\": "Classes"
        }
    },
    "require": {
        "php": "^8.2",
		"typo3/cms-backend": "^13.4 || ^14.3",
		"typo3/cms-core": "^13.4 || ^14.3",
		"typo3/cms-extbase": "^13.4 || ^14.3",
		"typo3/cms-fluid": "^13.4 || ^14.3",
		"typo3/cms-frontend": "^13.4 || ^14.3"
    },
	"require-dev": {
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "saschaegerer/phpstan-typo3": "^2.1 || ^3.1",
        "ssch/typo3-rector": "^3.1",
        "typo3/cms-install": "^13.4 || ^14.3",
        "typo3/coding-standards": "^0.8.0"
    },
    "scripts": {
        "lint": [
            "! find Classes Configuration -type f -name \"*.php\" -exec php -d error_reporting=32767 -l {} \\; 2>&1 >&- | grep \"^\""
        ],
		"cs": ".Build/vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php -v --using-cache=no --diff --dry-run ",
		"rector": ".Build/vendor/bin/rector process -c rector.php --clear-cache --output-format=console --dry-run"
	},
    "replace": {
        "typo3-ter/mapgeoadmin": "self.version"
    },
	"config": {
		"lock":false,
		"sort-packages": true,
		"vendor-dir": ".Build/vendor",
        "allow-plugins": {
			"phpstan/extension-installer": true,
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
        }
	},
    "extra": {
        "typo3/cms": {
            "extension-key": "mapgeoadmin",
            "web-dir": ".Build/public"
        }
    }
}
